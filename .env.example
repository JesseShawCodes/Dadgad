# Application
title="DADGAD"
environment="development"

# Apple Music API
apple_key_id=""
apple_team_id=""
apple_auth_key=
apple_search_url="https://api.music.apple.com/v1/catalog/us/search?term="
apple_artist_details_url="https://api.music.apple.com/v1/catalog/us/"

# Docker Compose — PostgreSQL
POSTGRES_USER='postgres'
POSTGRES_PASSWORD='postgres'
POSTGRES_DB='maddness'

# Django local database settings (must match POSTGRES_* above)
database_name='maddness'
database_user='postgres'
database_password='postgres'
database_host='127.0.0.1'
database_port='5432'

# pgAdmin (docker-compose service on :8888)
PGADMIN_DEFAULT_EMAIL="admin@example.com"
PGADMIN_DEFAULT_PASSWORD="change-me"

# Django
# Package default picks local vs production from `environment` / DJANGO_ENV.
# Or set explicitly: madness_backend.settings.local | .production
DJANGO_SETTINGS_MODULE=madness_backend.settings
DJANGO_SECRET_KEY="change-me-to-a-long-random-string"
# Comma-separated hosts for production (no wildcards)
allowed_hosts='localhost,127.0.0.1'

# Redis / Celery
REDIS_URL="redis://localhost:6379/0"
UPSTASH_REDIS_URL="redis://localhost:6379/0"

# Frontend (set in services/dadgad/.env.local for Next.js)
# NEXT_PUBLIC_SERVER=http://localhost:8000
# NEXT_PUBLIC_NAME=Dadgad
# NEXT_PUBLIC_MAINTENANCE_MODE=
